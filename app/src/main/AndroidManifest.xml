<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Exactly what M9 can actually do, and nothing declared ahead of code that uses it: read
         the message store, resolve an address to a contact name, receive SMS and MMS while it
         holds ROLE_SMS, send, and notify. Each milestone added only its own — an unused SMS
         permission prompt is a scary, unexplainable ask, and M9's permission story is one it has
         to be able to explain in a sentence.

         Two absences are deliberate and permanent. WRITE_CONTACTS: M9 reads the address book and
         never writes it, exactly like P9 — which is also why it registers no ContactsActions with
         :contacts. CALL_PHONE: the call key hands off with ACTION_DIAL, so a messaging app never
         holds the permission to place a call itself.

         There is no INTERNET permission either, and that is not an oversight — SMS goes over the
         radio via SmsManager, and even MMS, when it eventually lands, is carried by the platform's
         own MMS service rather than a socket M9 opens. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- required="false", the same call P9's manifest makes and for the same reason: M9 still
         installs (if uselessly) on a telephony-less device rather than being filtered out of the
         store entirely. Reading an existing message store is in fact the one thing that still
         works there. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <application
        android:name=".M9Application"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Nine"
        android:allowBackup="true">

        <!-- M9's only launcher entry (single-surface, like P9/T9 — see M9Application.kt/
             P9Application.kt, the template this follows). -->
        <activity
            android:name=".conversations.ConversationListActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="stateAlwaysHidden"
            android:configChanges="keyboardHidden|orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- One of the four components ROLE_SMS requires: something that answers ACTION_SENDTO
                 for the sms:/smsto:/mms:/mmsto: schemes. It belongs on the compose screen, which
                 doesn't exist until M5 — until then it lands here, which at least opens M9 rather
                 than failing to resolve. Move it to ComposeActivity when that arrives; leaving it
                 in both places would make "message this number" ambiguous. -->
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </activity>

        <activity
            android:name=".conversations.ConversationActivity"
            android:exported="false"
            android:theme="@style/Theme.Nine" />

        <activity
            android:name=".conversations.MessageDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.Nine" />

        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Nine" />

        <!-- The remaining three ROLE_SMS components. Each carries the sender-side permission the
             platform requires, so only the system can deliver these broadcasts. Without all four
             declared, M9 doesn't even appear as a candidate default SMS app. -->

        <!-- Delivered to the default SMS app alone, and the platform does not store the message
             on its behalf — see SmsDeliverReceiver. -->
        <receiver
            android:name=".sms.SmsDeliverReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>

        <!-- Inbound MMS. M9 can't display these; MmsPushReceiver preserves the raw PDU and says
             so out loud rather than dropping it silently. -->
        <receiver
            android:name=".sms.MmsPushReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>

        <!-- Not exported: it only ever receives the PendingIntent broadcasts SmsSender itself
             creates, so nothing outside M9 has any business reaching it. -->
        <receiver
            android:name=".sms.SmsResultReceiver"
            android:exported="false" />

        <service
            android:name=".sms.HeadlessSmsSendService"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>

    </application>
</manifest>
