<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Exactly what M2 can actually do: read the message store, and resolve an address to a
         contact name. Each milestone's manifest reflects the app's real abilities — an unused
         SMS permission prompt is a scary, unexplainable ask, and M9's whole permission story is
         one it has to be able to explain. RECEIVE_SMS/SEND_SMS/RECEIVE_MMS/POST_NOTIFICATIONS/
         READ_PHONE_STATE and the four ROLE_SMS components (SMS_DELIVER receiver,
         WAP_PUSH_DELIVER receiver, the smsto: activity filter, HeadlessSmsSendService) arrive
         with M3/M4, when there is code behind them. WRITE_CONTACTS is never declared: M9 reads
         the address book and never writes it, exactly like P9. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- required="false", the same call P9's manifest makes and for the same reason: M9 still
         installs (if uselessly) on a telephony-less device rather than being filtered out of the
         store entirely. Reading an existing message store is in fact the one thing that still
         works there. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <application
        android:name=".M9Application"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Nine"
        android:allowBackup="true">

        <!-- M9's only launcher entry (single-surface, like P9/T9 — see M9Application.kt/
             P9Application.kt, the template this follows). Becomes the conversation list once
             M2 lands; for M1 it's a placeholder that shows Settings/Manual only. -->
        <activity
            android:name=".conversations.ConversationListActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="stateAlwaysHidden"
            android:configChanges="keyboardHidden|orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Nine" />

    </application>
</manifest>
